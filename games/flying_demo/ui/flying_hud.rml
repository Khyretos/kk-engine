<rml>
<head>
    <title>Flying HUD</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Over the game: nothing here takes clicks. Everything keeps 3%
           off the edges (TV overscan, phone notches). */
        body { pointer-events: none; }
        /* One panel per player, in the top left corner of their view. */
        .player { position: absolute; }
        .card { position: absolute; left: 3%; top: 20dp; width: 250dp; padding: 10dp 14dp; border-radius: 10dp; background-color: #0b0f1ccc;
                border-left: 3dp #56a8ff; }
        .card .name { font-size: 12dp; letter-spacing: 2dp; color: #aab3cc; }
        .card .big { font-size: 30dp; font-weight: bold; color: #ffffff; }
        .card .sub { font-size: 13dp; color: #cfd6e6; }
        .card .gauges { margin-top: 6dp; font-size: 15dp; color: #ffffff; }
        .card .gauge { display: inline-block; width: 50%; }
        .card .label { font-size: 11dp; color: #7f8aa8; letter-spacing: 1dp; }
        .bar { height: 8dp; margin: 6dp 0 2dp 0; border-radius: 4dp; background-color: #26304d; }
        .fill { height: 8dp; border-radius: 4dp; background-color: #ffcf5c; }
        .health .fill { background-color: #5cd98a; }
        .health.hurt .fill { background-color: #ff6b5c; }
        .status { font-size: 13dp; color: #ffcf5c; margin-top: 4dp; }
        .stall .status, .down .status { color: #ff6b5c; font-weight: bold; animation: 0.35s linear infinite alternate blink; }
        @keyframes blink { from { opacity: 1; } to { opacity: 0.4; } }
        .device { font-size: 11dp; color: #7f8aa8; margin-top: 4dp; }
        /* Which way the next ring is. */
        .arrow { position: absolute; left: 50%; top: 14%; width: 40dp; height: 40dp; margin-left: -20dp; font-size: 34dp; font-weight: bold;
                 text-align: center; color: #ffcf5c; }
        /* Dogfight: the gun sight, where the nose points; red on a hit. */
        .sight { position: absolute; width: 34dp; height: 34dp; margin-left: -17dp; margin-top: -17dp; border: 2dp #ffffffcc; border-radius: 17dp; }
        .sight .dot { position: absolute; left: 14dp; top: 14dp; width: 2dp; height: 2dp; background-color: #ffffff; }
        .sight.hit { border-color: #ff5c5c; }
        .sight.hit .dot { background-color: #ff5c5c; }
        .trick { position: absolute; left: 0; top: 24%; width: 100%; text-align: center; font-size: 26dp; font-weight: bold; color: #ffffff; }
        /* Everyone, leader first. */
        #standings { position: absolute; right: 3%; top: 64dp; width: 220dp; padding: 8dp 12dp; border-radius: 10dp; background-color: #0b0f1ccc; }
        .row { display: block; font-size: 14dp; color: #e8ecf4; padding: 2dp 0; }
        .row.you { font-weight: bold; color: #ffffff; }
        .row .place { display: inline-block; width: 22dp; color: #aab3cc; }
        .row .dot { display: inline-block; width: 10dp; height: 10dp; border-radius: 5dp; margin-right: 8dp; }
        .row .what { float: right; color: #aab3cc; }
        #clock { position: absolute; left: 0; top: 20dp; width: 100%; text-align: center; font-size: 20dp; font-weight: bold; color: #ffffff; }
        #banner { position: absolute; top: 34%; left: 0; width: 100%; text-align: center; }
        #banner .big { font-size: 72dp; font-weight: bold; color: #ffffff; }
        #banner .sub { display: inline-block; font-size: 18dp; color: #e8ecf4; margin-top: 6dp; padding: 4dp 14dp; border-radius: 8dp;
                       background-color: #0b0f1caa; }
        #banner .sub img { font-size: 22dp; }
        #flash { position: absolute; top: 26%; left: 0; width: 100%; text-align: center; font-size: 30dp; font-weight: bold; color: #ffcf5c; }
        #hint { position: absolute; left: 8%; bottom: 3%; width: 84%; padding: 6dp 10dp; border-radius: 8dp; background-color: #0b0f1cbb;
                text-align: center; font-size: 13dp; color: #cfd6e6; }
        #hint img { font-size: 17dp; }
        #art { position: absolute; left: 3%; bottom: 10%; width: 60%; font-size: 12dp; color: #cfd6e6; }
        /* Phones: the context already keeps to the safe area with its own
           margin (docs/INPUT.md "Phone, PC and console"), so the panels sit
           at its edges; upright, the standings and the clock go under the
           player's panel instead of beside it. */
        body.kke-phone .card { left: 0; top: 0; }
        body.kke-phone #standings { right: 0; top: 44dp; }
        body.kke-phone #clock { top: 0; }
        body.kke-phone #hint { left: 0; width: 100%; bottom: 0; }
        body.kke-portrait #standings { top: 205dp; right: auto; left: 0; }
        body.kke-portrait #clock { top: 205dp; left: auto; right: 0; width: 120dp; text-align: right; }
        body.kke-portrait .arrow { top: 36%; }
        body.kke-portrait #pause .sheet { width: 92%; left: 4%; margin-left: 0; top: 8%; }
        /* The pause menu. */
        #pause { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #05070ecc; }
        #pause .sheet { position: absolute; left: 50%; top: 18%; width: 560dp; margin-left: -280dp; padding: 18dp 22dp; border-radius: 12dp;
                        background-color: #141b2e; }
        #pause h1 { display: block; font-size: 28dp; font-weight: bold; color: #ffffff; margin-bottom: 12dp; }
        .item { display: block; font-size: 18dp; color: #cfd6e6; padding: 8dp 12dp; border-radius: 8dp; }
        .item.focused { background-color: #2a3a66; color: #ffffff; }
        .item .value { float: right; color: #ffcf5c; }
        .item.taken .value { color: #ff6b5c; }
        .devices { margin-top: 12dp; font-size: 13dp; color: #aab3cc; }
        .devices div { padding: 1dp 12dp; }
        .phint { margin-top: 12dp; font-size: 13dp; color: #7f8aa8; text-align: center; }
        .phint img { font-size: 17dp; }
    </style>
</head>
<body data-model="flying">
    <div data-if="flying">
        <div data-for="p : players" class="player" data-class-stall="p.stall" data-class-down="p.down" data-style-left="p.x" data-style-top="p.y"
             data-style-width="p.w" style="height: 100%;">
            <div class="card" data-style-border-left-color="p.accent">
                <div class="name">{{p.name}}</div>
                <div class="big">{{p.big}}</div>
                <div class="sub">{{p.sub}}</div>
                <div class="gauges"><span class="gauge"><span class="label">SPEED </span>{{p.speed}}</span><span class="gauge"><span class="label">HEIGHT </span>{{p.altitude}}</span></div>
                <div class="bar"><div class="fill" data-style-width="p.throttle"></div></div>
                <div class="label">THROTTLE {{p.throttle}}</div>
                <div class="bar health" data-class-hurt="p.hurt"><div class="fill" data-style-width="p.health"></div></div>
                <div class="label">HEALTH {{p.health}}</div>
                <div class="status" data-if="p.status != ''">{{p.status}}</div>
                <div class="device">{{p.device}}</div>
            </div>
            <div class="arrow" data-if="p.arrow != 'none'" data-style-transform="p.arrow">^</div>
            <div class="trick" data-if="p.trick != ''">{{p.trick}}</div>
            <div class="sight" data-if="p.sight" data-class-hit="p.hit" data-style-left="p.sight_x" data-style-top="p.sight_y"><div class="dot"></div></div>
        </div>
        <div id="standings" data-if="standings.size > 0">
            <div data-for="r : standings" class="row" data-class-you="r.you"><span class="place">{{r.place}}</span><span class="dot" data-style-background-color="r.accent"></span>{{r.name}}<span class="what">{{r.what}}</span></div>
        </div>
        <div id="clock" data-if="clock != ''">{{clock}}</div>
        <div id="flash" data-if="flash != '' && banner == ''">{{flash}}</div>
        <div id="banner" data-if="banner != ''">
            <div class="big">{{banner}}</div>
            <div class="sub" data-if="sub != ''" data-rml="sub"></div>
        </div>
        <div id="hint" data-if="hint != '' && !paused" data-rml="hint"></div>
        <div id="pause" data-if="paused">
            <div class="sheet">
                <h1>{{pause_title}}</h1>
                <div data-for="r : pause" class="item" data-class-focused="r.focused" data-class-taken="r.taken">{{r.label}}<span class="value" data-if="r.value != ''"><span data-if="r.arrows">&lt; </span>{{r.value}}<span data-if="r.arrows"> &gt;</span></span></div>
                <div class="devices" data-if="devices.size > 0">
                    <div>Plugged in:</div>
                    <div data-for="d : devices">{{d}}</div>
                </div>
                <div class="phint" data-rml="pause_hint"></div>
            </div>
        </div>
        <div id="art" data-if="art_status != '' && !paused">{{art_status}}</div>
    </div>
</body>
</rml>
