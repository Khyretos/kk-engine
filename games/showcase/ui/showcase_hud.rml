<rml>
<head>
    <title>Showcase HUD</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Over the game: nothing here takes clicks. */
        body { pointer-events: none; }
        #move { position: absolute; left: 24dp; bottom: 28dp; padding: 8dp 14dp; border-radius: 8dp;
                background-color: #0b0f1ccc; border-left: 3dp #56628e; font-size: 15dp; }
        #move .state { font-weight: bold; }
        #move .speed { color: #aab3cc; margin-left: 10dp; }
        #move.trick { border-left-color: #ffcf5c; }
        #station { position: absolute; left: 50%; bottom: 28dp; width: 460dp; margin-left: -230dp; padding: 10dp 16dp;
                   border-radius: 10dp; text-align: center; animation: 0.3s cubic-out slide-up; }
        #station .name { font-size: 13dp; letter-spacing: 3dp; color: #ffcf5c; }
        #station .text { font-size: 15dp; color: #e8ecf4; margin-top: 3dp; }
        #station .live { font-size: 13dp; color: #aab3cc; margin-top: 3dp; }
        #prompt { position: absolute; left: 50%; bottom: 128dp; width: 400dp; margin-left: -200dp; text-align: center; font-size: 15dp; color: #ffffff; }
        #toast { position: absolute; left: 50%; top: 18%; width: 500dp; margin-left: -250dp; text-align: center; padding: 8dp 14dp;
                 border-radius: 8dp; background-color: #0b0f1ccc; font-size: 15dp; color: #6fe39a; animation: 0.2s cubic-out slide-up; }
        /* The gun: a crosshair in the middle, rounds bottom right. */
        #crosshair { position: absolute; left: 50%; top: 50%; width: 22dp; height: 22dp; margin-left: -11dp; margin-top: -11dp; }
        #crosshair .h { position: absolute; left: 0dp; top: 10dp; width: 22dp; height: 2dp; background-color: #ffffffcc; }
        #crosshair .v { position: absolute; left: 10dp; top: 0dp; width: 2dp; height: 22dp; background-color: #ffffffcc; }
        #crosshair .dot { position: absolute; left: 9dp; top: 9dp; width: 4dp; height: 4dp; background-color: #ff5c4d; }
        #ammo { position: absolute; right: 24dp; bottom: 56dp; padding: 6dp 12dp; border-radius: 8dp; background-color: #0b0f1ccc;
                font-size: 20dp; font-weight: bold; color: #e8ecf4; }
        #ammo .reload { font-size: 13dp; font-weight: normal; color: #ffcf5c; margin-left: 8dp; }
        #esc { position: absolute; right: 24dp; bottom: 28dp; font-size: 12dp; color: #8b93aa; }
    </style>
</head>
<body data-model="demo">
    <div id="move" data-class-trick="trick">
        <span class="state">{{move}}</span><span class="speed">{{speed}}</span>
    </div>
    <div id="station" class="glass" data-if="station != ''">
        <div class="name">{{station}}</div>
        <div class="text" data-rml="station_text"></div>
        <div class="live" data-if="station_live != ''">{{station_live}}</div>
    </div>
    <div id="prompt" data-if="prompt != ''" data-rml="prompt"></div>
    <div id="toast" data-if="toast != ''">{{toast}}</div>
    <div id="crosshair" data-if="crosshair"><div class="h"></div><div class="v"></div><div class="dot"></div></div>
    <div id="ammo" data-if="ammo != ''">{{ammo}}<span class="reload" data-if="reloading">reloading</span></div>
    <div id="esc" data-rml="menu_hint"></div>
</body>
</rml>
