<rml>
<head>
    <title>Input</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        body { background-color: #05070ecc; }
        #window {
            position: absolute; left: 50%; top: 8%; width: 1180dp; max-width: 97%; height: 84%;
            transform: translateX(-50%);
            animation: 0.35s cubic-out slide-up;
        }
        #cols { position: absolute; left: 16dp; right: 16dp; top: 44dp; bottom: 56dp; }
        #left { position: absolute; left: 0; top: 0; width: 46%; height: 100%; overflow-y: auto; }
        #right { position: absolute; right: 0; top: 0; width: 52%; height: 100%; overflow-y: auto; }

        .device { display: block; padding: 7dp 10dp; margin-bottom: 6dp; border-radius: 6dp;
                  background-color: #0d1120; border: 1dp #2a3458; cursor: pointer; transition: background-color 0.2s; }
        .device:hover { border-color: #7a9bff; }
        .device.selected { border-color: #ffcf5c; }
        .device.active { background-color: #24407a; }
        .device.offline { color: #5d6580; }
        .device .type { float: right; font-size: 11dp; color: #8b93aa; }
        .device .info { display: block; font-size: 11dp; color: #8b93aa; }
        .device .twin { display: inline-block; margin-left: 6dp; padding: 0 6dp; font-size: 11dp; border-radius: 4dp;
                        background-color: #5a3a8a; color: #ffffff; }

        .cells { display: block; margin: 4dp 0; }
        .cell { display: inline-block; min-width: 26dp; padding: 3dp 5dp; margin: 2dp; text-align: center; font-size: 12dp;
                border-radius: 4dp; background-color: #151b30; border: 1dp #2a3458; color: #8b93aa; }
        .cell.on { background-color: #ffcf5c; color: #10131f; border-color: #fff2c4; }
        .axis { display: block; margin: 3dp 0; font-size: 12dp; }
        .axis .name { display: inline-block; width: 90dp; color: #8b93aa; }
        .axis .track { display: inline-block; position: relative; width: 58%; height: 10dp; vertical-align: -1dp;
                       background-color: #0b0f1c; border: 1dp #2d3658; border-radius: 3dp; }
        .axis .fill { position: absolute; top: 0; height: 10dp; background-color: #4f7cff; }
        .axis .mid { position: absolute; left: 50%; top: 0; width: 1dp; height: 10dp; background-color: #3a4670; }
        .axis .val { display: inline-block; width: 50dp; text-align: right; color: #ffcf5c; }
        .mono { font-size: 12dp; color: #cfd9ff; }

        .cat { display: block; margin: 12dp 0 4dp 0; font-size: 12dp; letter-spacing: 2dp; color: #8b93aa; }
        .action { display: block; padding: 6dp 8dp; margin-bottom: 4dp; border-radius: 5dp; background-color: #0d1120; border: 1dp #1f2742; }
        .action.held { border-color: #6fe39a; }
        .action.flash { background-color: #1f3b2c; }
        .action .label { display: inline-block; width: 38%; }
        .action .value { display: inline-block; width: 22%; font-size: 12dp; color: #6fe39a; }
        .action .tools { float: right; }
        .chip { display: inline-block; padding: 3dp 7dp; margin: 3dp 4dp 0 0; border-radius: 4dp; font-size: 12dp;
                background-color: #1a2242; border: 1dp #3a4670; }
        .chip.conflict { border-color: #ff7373; }
        .chip .trig { color: #ffcf5c; cursor: pointer; margin-left: 6dp; }
        .chip .x { color: #ff7373; cursor: pointer; margin-left: 6dp; }
        .add { display: inline-block; padding: 3dp 7dp; margin: 3dp 4dp 0 0; border-radius: 4dp; font-size: 12dp; color: #7a9bff;
               border: 1dp #3a4670; cursor: pointer; }
        .add:hover, .chip .trig:hover, .chip .x:hover { color: #ffffff; }

        #capture { position: absolute; left: 20%; right: 20%; top: 35%; padding: 20dp; text-align: center;
                   background-color: #121833f2; border: 2dp #ffcf5c; border-radius: 10dp; animation: 1s sine-in-out infinite pulse; }
        #bottom { position: absolute; left: 16dp; right: 16dp; bottom: 12dp; height: 36dp; border-top: 1dp #2f3a5c; padding-top: 8dp; }
        #bottom .status { display: inline-block; color: #6fe39a; margin-top: 6dp; font-size: 13dp; }
        #bottom .btns { float: right; }
        @media (max-width: 900px) { #left, #right { position: static; width: 100%; height: auto; } #cols { overflow-y: auto; } }
    </style>
</head>
<body data-model="input">
<div id="window" class="panel glass">
    <div class="title-bar">INPUT — test every controller, name identical ones, bind anything to anything. {{ last_input }}</div>
    <div id="cols">
        <div id="left">
            <h3>Devices</h3>
            <div class="muted" style="font-size: 12dp;">Press or move something: its card lights up. Identical devices (e.g. a HOSAS pair) are numbered by USB port; name them, and Swap if they are the wrong way round.</div>
            <div data-for="d : devices" class="device" data-class-selected="d.selected" data-class-active="d.active" data-class-offline="!d.connected"
                 data-event-click="select_device(d.ref)">
                <span class="type">{{ d.type }}</span>{{ d.label }}<span class="twin" data-if="d.twin != ''">{{ d.twin }}</span>
                <span class="info" data-if="d.info != ''">{{ d.info }}</span>
            </div>

            <h3>{{ selected_name }}</h3>
            <div class="muted" style="font-size: 11dp;">{{ selected_key }}</div>
            <div class="row">
                <input type="text" data-value="alias" style="width: 180dp;"/>
                <button class="small" data-event-click="rename()">Name it</button>
                <button class="small" data-event-click="swap_twin()">Swap twin</button>
                <button class="small" data-event-click="identify(selected)">Identify (rumble/LED)</button>
            </div>
            <div data-if="pad_buttons.size > 0">
                <div class="muted" style="font-size: 12dp;">Gamepad buttons</div>
                <div class="cells"><span data-for="c : pad_buttons" class="cell" data-class-on="c.on">{{ c.name }}</span></div>
            </div>
            <div data-if="buttons.size > 0">
                <div class="muted" style="font-size: 12dp;">Raw buttons</div>
                <div class="cells"><span data-for="c : buttons" class="cell" data-class-on="c.on">{{ c.name }}</span></div>
            </div>
            <div data-if="hats.size > 0" class="cells"><span data-for="c : hats" class="cell" data-class-on="c.on">{{ c.name }}</span></div>
            <div data-for="ax : axes" class="axis">
                <span class="name">{{ ax.name }}</span>
                <span class="track"><span class="mid"></span><span class="fill" data-style-left="ax.left" data-style-width="ax.width"></span></span>
                <span class="val">{{ ax.value }}</span>
            </div>
            <div class="mono" data-if="sensors != ''">{{ sensors }}</div>
            <div class="mono" data-if="touch != ''">{{ touch }}</div>
        </div>

        <div id="right">
            <h3>Bindings</h3>
            <div class="muted" style="font-size: 12dp;">Any number of bindings per action. Click a trigger to cycle it (press, hold, tap, double tap, toggle, release, while held). Red = the same input does two things.</div>
            <div data-for="a : actions">
                <div class="cat" data-if="a.first">{{ a.category }}</div>
                <div class="action" data-class-held="a.held" data-class-flash="a.flash">
                    <span class="label">{{ a.label }}</span><span class="value">{{ a.value }}</span>
                    <span class="tools">
                        <span class="add" data-if="a.type == 'button'" data-event-click="bind(a.id)">+ Add</span>
                        <span data-if="a.type == 'axis2d'"><span class="add" data-event-click="bind(a.id, 'up')">+ Up</span><span class="add" data-event-click="bind(a.id, 'down')">+ Down</span><span class="add" data-event-click="bind(a.id, 'left')">+ Left</span><span class="add" data-event-click="bind(a.id, 'right')">+ Right</span></span>
                        <span data-if="a.type == 'axis'"><span class="add" data-event-click="bind(a.id, 'pos')">+ Add (+)</span><span class="add" data-event-click="bind(a.id, 'neg')">+ Add (-)</span></span>
                        <span class="add" data-event-click="reset_action(a.id)">Reset</span>
                    </span>
                    <div>
                        <span data-for="b : a.bindings" class="chip" data-class-conflict="b.conflict">{{ b.text }}<span class="trig" data-event-click="cycle_trigger(b.index)">{{ b.trigger }}</span><span class="x" data-event-click="unbind(b.index)">x</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="bottom">
        <span class="status">{{ status }}</span>
        <span class="btns">
            <button class="small" data-event-click="left_handed()">Left-handed keys</button>
            <button class="small" data-event-click="reload()">Revert</button>
            <button class="small danger" data-event-click="reset_all()">Reset all</button>
            <button class="small primary" data-event-click="save()">Save</button>
        </span>
    </div>
    <div id="capture" data-if="capturing">
        <h2>Listening…</h2>
        <div>{{ capture_hint }}</div>
        <button class="small" data-event-click="cancel_capture()" style="margin-top: 10dp;">Cancel</button>
    </div>
</div>
</body>
</rml>
