#!/usr/bin/env python3
"""Runs a game for a few seconds and says whether its scripts work.

Made for checking a change without playing: by you, by CI, or by an AI
assistant that can run commands but can't see a window (docs/AI_ASSISTANTS.md).

    tools/check_game starter_game                  # the game's own scripts
    tools/check_game my_game --scripts path/to/dir # another scripts folder
    tools/check_game my_game --shot look.jpg       # and a screenshot
    tools/check_game my_game --keys "space w"      # press keys while it runs
    tools/check_game my_game --pad --headless      # virtual gamepad, Xvfb even on a desktop

Repeatable test runs (docs/TEST_HARNESS.md): a fixed frame count at
1/60 s a frame, input recorded or played back, screenshots compared:

    tools/check_game my_game --frames 600 --record walk.tape --headless
    tools/check_game my_game --frames 600 --replay walk.tape \
        --shots 300:mid.png,590:end.png --expect tests/refs/my_game

It prints what the scripts printed, every warning and error, then one
last line: "OK" or "FAILED". Exit code 0 means no errors. Build the game
first (cmake --build build --target my_game). With no DISPLAY (or with
--headless) it starts Xvfb itself, so it works on a server with no screen
(software Vulkan, lavapipe, is enough; without lavapipe the real GPU
draws into Xvfb). The first line says which mode and Vulkan device ran.
Keys go through xdotool, or python-xlib when xdotool isn't installed.
"""

import argparse
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True  # no __pycache__ in the checkout
sys.path.insert(0, str(ROOT / "tools" / "runner"))
import xdisplay  # noqa: E402  (tools/runner/xdisplay.py)

LINE = re.compile(r"^\[[^\]]*\]\[[^\]]*\]\[(?P<who>[^\]]*)\]\[[^\]]*\]\[(?P<level>[a-z]+)\]: (?P<text>.*)$")
# Said on stderr once the log is closed (the quit watchdog in Application.cpp).
LATE = re.compile(r"^\[kke\]\[(?P<level>[a-z]+)\]: (?P<text>.*)$")
# Warnings that are about the machine, not the game.
MACHINE = ("validation layers requested but not available",)


def start_display(headless):
    """Starts Xvfb when there is no screen or headless is asked for;
    returns it (or None when the existing display is used)."""
    if os.environ.get("DISPLAY") and not headless:
        return None
    if not shutil.which("Xvfb"):
        sys.exit("check_game: no DISPLAY and no Xvfb (install xvfb, or run it on a desktop)")
    xvfb = xdisplay.Xvfb()
    os.environ["DISPLAY"] = xvfb.name
    return xvfb


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("game", nargs="?", default="starter_game", help="the game's target name (default starter_game)")
    ap.add_argument("--bin", default=str(ROOT / "build" / "bin"), help="where the built games are")
    ap.add_argument("--scripts", help="run this scripts folder instead of the game's own")
    ap.add_argument("--seconds", type=float, default=8, help="how long to run (default 8)")
    ap.add_argument("--keys", help="keys to press after 3 s, space-separated X key names (xdotool or python-xlib)")
    ap.add_argument("--shot", help="save a screenshot here (.jpg or .png) just before it stops")
    ap.add_argument("--headless", action="store_true", help="run inside Xvfb even when a desktop is there")
    ap.add_argument("--pad", action="store_true", help="plug in a virtual gamepad that moves its sticks")
    ap.add_argument("--log", help="also save the game's whole log here")
    ap.add_argument("--frames", type=int, help="run exactly this many frames at a fixed 1/60 s each, then quit (repeatable runs; --seconds becomes the time limit)")
    ap.add_argument("--record", help="write the run's keyboard/mouse input to this tape (docs/TEST_HARNESS.md)")
    ap.add_argument("--replay", help="play this input tape back, frame for frame")
    ap.add_argument("--shots", help="screenshots at frames, e.g. 60:start.png,240:end.png (PNG, taken by the engine)")
    ap.add_argument("--expect", help="folder of reference pictures: compare the --shots with them (kke_imgdiff)")
    ap.add_argument("--arg", action="append", default=[], help="pass this to the game on its command line (repeat for more), e.g. sandbox --arg games/my_game")
    args = ap.parse_args()

    # The game runs in its own folder: a path given here means this one.
    args.arg = [str(pathlib.Path(a).resolve()) if pathlib.Path(a).exists() else a for a in args.arg]
    binary = pathlib.Path(args.bin) / args.game
    if not binary.exists():
        sys.exit(f"check_game: {binary} not found; build it first: cmake --build build --target {args.game}")

    xvfb = start_display(args.headless)
    mode = xdisplay.headless_note() if xvfb else f"desktop window on {os.environ['DISPLAY']} (real GPU)"
    # Full speed and pads heard without the focus: the desktop's owner may be
    # using another window while it runs (the game's background cap is for players).
    env = dict(os.environ, KKE_SKIP_INTRO="1", KKE_FULL_SPEED_IN_BACKGROUND="1", SDL_VIDEODRIVER=os.environ.get("SDL_VIDEODRIVER", "x11"))
    if xvfb:
        env.update(xdisplay.headless_env())
    if args.pad:
        env.update(KKE_VIRTUAL_INPUT="pad", KKE_VIRTUAL_INPUT_ANIMATE="1")
    env.setdefault("KKE_MAIN_MENU", "0")  # straight into the game, past the title (docs/GAME_SHELL.md)
    shot_files = []
    if args.frames:
        env.update(KKE_FIXED_DT="60", KKE_QUIT_AT_FRAME=str(args.frames))
        if args.seconds == ap.get_default("seconds"):
            args.seconds = max(30.0, args.frames / 10.0)
    if args.record:
        env["KKE_INPUT_RECORD"] = str(pathlib.Path(args.record).resolve())
    if args.replay:
        env["KKE_INPUT_PLAYBACK"] = str(pathlib.Path(args.replay).resolve())
    if args.shots:
        plan = []
        for item in filter(None, args.shots.split(",")):
            frame, _, name = item.partition(":")
            path = pathlib.Path(name).resolve()
            shot_files.append(path)
            plan.append(f"{frame}:{path}")
        env["KKE_SHOTS"] = ",".join(plan)
    if args.expect and not args.shots:
        sys.exit("check_game: --expect compares the --shots: give --shots too")
    if args.scripts:
        env["KKE_SCRIPTS_DIR"] = str(pathlib.Path(args.scripts).resolve())
    try:
        with tempfile.TemporaryFile(mode="w+") as log:
            proc = subprocess.Popen([str(binary), *args.arg], cwd=binary.parent, env=env, stdout=log, stderr=subprocess.STDOUT)
            started = time.monotonic()
            hung = False
            try:
                if args.keys:
                    time.sleep(3)
                    xdisplay.press(env["DISPLAY"], None, args.keys, hold=0.4, pid=proc.pid)
                if args.frames:
                    # The game quits by itself after --frames; --seconds is only the limit.
                    try:
                        proc.wait(max(0.0, args.seconds - (time.monotonic() - started)))
                    except subprocess.TimeoutExpired:
                        print(f"-- still running after {args.seconds:g} s: it never reached frame {args.frames}")
                time.sleep(max(0.0, args.seconds - (time.monotonic() - started) - (0.5 if args.shot else 0)) if not args.frames else 0)
                if args.shot and proc.poll() is not None:
                    print("-- no screenshot: the game had already quit")
                    args.shot = None
                if args.shot:
                    # On a desktop, only the game's own window.
                    window = None if xvfb else xdisplay.window_id(env["DISPLAY"], pid=proc.pid)
                    xdisplay.screenshot(env["DISPLAY"], args.shot, window)
                    time.sleep(0.5)
                exited = proc.poll()
            finally:
                proc.terminate()
                try:
                    proc.wait(10)
                except subprocess.TimeoutExpired:
                    hung = True
                    proc.kill()
                    proc.wait()
            log.seek(0)
            text = log.read()
            if args.log:
                pathlib.Path(args.log).write_text(text)
    finally:
        if xvfb:
            xvfb.stop()

    print(f"-- mode: {mode}; Vulkan device: {xdisplay.device_used(text)}")
    printed, warnings, errors = [], [], []
    for raw in text.splitlines():
        m = LINE.match(raw)
        if not m:
            if "Fatal error" in raw or "Segmentation fault" in raw:
                errors.append(raw)
            elif late := LATE.match(raw):
                (warnings if late["level"] == "warning" else errors).append(f"quitting: {late['text']}")
            continue
        level, who, said = m["level"], m["who"], m["text"]
        if level in ("error", "critical"):
            errors.append(f"{who}: {said}")
        elif level == "warning" and not any(s in said for s in MACHINE):
            warnings.append(f"{who}: {said}")
        elif who == "Scripts" and level == "info" and re.match(r"[\w./-]+\.lua: ", said):
            printed.append(said)

    for title, lines in (("printed by scripts", printed), ("warnings", warnings), ("errors", errors)):
        if lines:
            print(f"-- {title} ({len(lines)}):")
            print("\n".join("  " + line for line in lines[-40:]))
    for path in shot_files:
        if not path.exists():
            errors.append(f"screenshot {path.name} was not taken")
    if args.expect and shot_files and all(p.exists() for p in shot_files):
        tool = pathlib.Path(args.bin) / "kke_imgdiff"
        if not tool.exists():
            errors.append(f"{tool} not found: cmake --build build --target kke_imgdiff")
        for path in shot_files:
            ref = pathlib.Path(args.expect) / path.name
            if not tool.exists():
                break
            if not ref.exists():
                print(f"-- no reference {ref}: copy {path} there once it looks right")
                continue
            out = subprocess.run([str(tool), "--diff", str(path.parent / "diff"), str(ref), str(path)], capture_output=True, text=True)
            print("-- " + out.stdout.strip().splitlines()[0] if out.stdout.strip() else f"-- kke_imgdiff: {out.stderr.strip()}")
            if out.returncode != 0:
                errors.append(f"{path.name} differs from {ref}")
    if exited is not None and exited != 0:
        errors.append(f"the game stopped by itself with exit code {exited}")
        print(f"-- the game stopped by itself with exit code {exited}; last lines:")
        print("\n".join("  " + line for line in text.splitlines()[-15:]))
    if hung:
        errors.append("it did not quit within 10 s of being asked to")
        print("-- it did not quit within 10 s of being asked to (killed)")
    if args.shot:
        print(f"-- screenshot: {args.shot}")
    for path in shot_files:
        if path.exists():
            print(f"-- screenshot: {path}")
    ran = f"{args.frames} frames" if args.frames else f"{args.seconds:g} s"
    print("FAILED" if errors else f"OK: {args.game} ran {ran} with no errors" +
          (f" ({len(warnings)} warning(s) to fix)" if warnings else ""))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
