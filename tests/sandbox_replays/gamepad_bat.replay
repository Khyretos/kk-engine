# Play mode with only a gamepad: a person from the palette, the bat, a swing.
# KKE_SANDBOX_REPLAY=tests/sandbox_replays/gamepad_bat.replay ./sandbox
# (times assume the asset scan has finished; start it with the packs cached)
1.0 pad attach
2.0 pad button rb 1
2.1 pad button rb 0
2.3 pad button rb 1
2.4 pad button rb 0
# A on Person, hold, push the stick up, let go in the world
2.8 pad button a 1
3.0 pad axis lefty -1
3.35 pad axis lefty 0
3.6 pad button a 0
# Along the palette to the bat (Grab, Person, Bat) and pick it up
4.2 pad button rb 1
4.3 pad button rb 0
4.5 pad button rb 1
4.6 pad button rb 0
4.8 pad button rb 1
4.9 pad button rb 0
5.2 pad button a 1
5.3 pad button a 0
# Back up to the person (one cell to the left of where the stick went up) and swing
5.6 pad axis leftx -1
5.69 pad axis leftx 0
5.8 pad axis lefty -1
6.15 pad axis lefty 0
6.6 pad button a 1
6.7 pad button a 0
# Turn the view with the right stick
8.5 pad axis rightx 1
9.0 pad axis rightx 0
