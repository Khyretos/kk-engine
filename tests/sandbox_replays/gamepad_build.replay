# Build mode with only a gamepad: Start back to Play, Start opens the pause
# menu and closes it again, then the pointer ring moves left and the right
# stick turns the view.
# KKE_MAIN_MENU=0 KKE_SANDBOX_MODE=build KKE_SANDBOX_REPLAY=tests/sandbox_replays/gamepad_build.replay ./sandbox
1.0 pad attach
2.0 pad button start 1
2.2 pad button start 0
3.0 pad button start 1
3.2 pad button start 0
4.0 pad button start 1
4.2 pad button start 0
4.5 pad axis leftx -0.6
5.5 pad axis leftx 0
5.7 pad axis rightx 0.8
6.2 pad axis rightx 0
