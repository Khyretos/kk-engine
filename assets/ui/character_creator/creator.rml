<rml>
<head>
    <title>Character creator</title>
    <link type="text/rcss" href="creator.rcss"/>
</head>
<!-- kke::CharacterCreatorModule (docs/HUMANS.md). Edit with the game
     running (KKE_CREATOR_UI=<this folder>) and press F5 to reload the stylesheet. -->
<body data-model="creator">
    <div id="views" class="bar">
        <button data-class-on="view == 'body'" data-event-click="view('body')">Body</button>
        <button data-class-on="view == 'face'" data-event-click="view('face')">Face</button>
        <button data-class-on="view == 'profile'" data-event-click="view('profile')">Profile</button>
        <button data-class-on="view == 'back'" data-event-click="view('back')">Back</button>
        <button data-class-on="turntable" data-event-click="toggle_turntable">Turn</button>
    </div>

    <div id="panel">
        <h1>Create your character</h1>
        <div id="tabs">
            <span class="tab" data-for="t : tabs" data-class-on="tab == t.id" data-event-click="set_tab(t.id)">{{ t.label }}</span>
        </div>

        <div class="tools" data-if="tab != 'skin' && tab != 'hair' && tab != 'clothes'">
            <button data-class-on="mirror" data-event-click="toggle_mirror">Mirror sides</button>
            <button data-event-click="randomise('tab')">Random</button>
            <button data-event-click="reset_tab">Reset tab</button>
        </div>

        <div id="sliders" data-if="tab != 'skin' && tab != 'hair' && tab != 'clothes'">
            <div class="slider" data-for="s, i : sliders">
                <span class="label">{{ s.label }}</span>
                <input type="range" data-attr-min="s.min" data-attr-max="s.max" step="0.01" data-value="s.value"/>
                <span class="value">{{ s.value | format(2) }}</span>
                <button class="reset" data-event-click="reset_slider(i)">Reset</button>
            </div>
        </div>

        <div id="colours" data-if="tab == 'skin'">
            <h2>Skin tone</h2>
            <div class="swatches">
                <span class="swatch" data-for="c, i : skin_swatches" data-style-background-color="c.css" data-event-click="skin(i)"><span class="tip">{{ c.name }}</span></span>
            </div>
            <h2>Eye colour</h2>
            <div class="swatches">
                <span class="swatch" data-for="c, i : eye_swatches" data-style-background-color="c.css" data-event-click="eyes(i)"><span class="tip">{{ c.name }}</span></span>
            </div>
            <p class="note">Skin textures and make-up arrive with the next steps of the creator.</p>
        </div>

        <div id="hair" data-if="tab == 'hair'">
            <h2>Hairstyle</h2>
            <div class="choices">
                <button data-for="h : hair_choices" data-class-on="hair_style == h.id" data-event-click="hair_style(h.id)">{{ h.label }}</button>
            </div>
            <h2>Colour</h2>
            <div class="swatches">
                <span class="swatch" data-for="c, i : hair_swatches" data-style-background-color="c.css" data-event-click="hair_colour(i)"><span class="tip">{{ c.name }}</span></span>
            </div>
            <h2>Length</h2>
            <div class="slider">
                <input type="range" min="0.4" max="1.8" step="0.05" data-value="hair_length"/>
                <span class="value">{{ hair_length | format(2) }}</span>
            </div>
            <p class="note">Every strand grows from this head's own scalp and moves with the engine's hair physics: press Turn to see it swing.</p>
        </div>

        <div id="clothes" data-if="tab == 'clothes'">
            <h2>Top</h2>
            <div class="choices">
                <span data-for="g : garments"><button data-if="g.slot == 'top'" data-class-on="g.worn" data-event-click="wear(g.id)">{{ g.label }}</button></span>
            </div>
            <h2>Bottom</h2>
            <div class="choices">
                <span data-for="g : garments"><button data-if="g.slot == 'bottom'" data-class-on="g.worn" data-event-click="wear(g.id)">{{ g.label }}</button></span>
            </div>
            <h2>Socks</h2>
            <div class="choices">
                <span data-for="g : garments"><button data-if="g.slot == 'socks'" data-class-on="g.worn" data-event-click="wear(g.id)">{{ g.label }}</button></span>
            </div>
            <h2>Shoes</h2>
            <div class="choices">
                <span data-for="g : garments"><button data-if="g.slot == 'shoes'" data-class-on="g.worn" data-event-click="wear(g.id)">{{ g.label }}</button></span>
            </div>
            <h2>{{ cloth_slot_label }}</h2>
            <div class="choices">
                <button data-class-on="cloth_slot == 'top'" data-event-click="cloth_slot('top')">Top</button>
                <button data-class-on="cloth_slot == 'bottom'" data-event-click="cloth_slot('bottom')">Bottom</button>
                <button data-class-on="cloth_slot == 'socks'" data-event-click="cloth_slot('socks')">Socks</button>
                <button data-class-on="cloth_slot == 'shoes'" data-event-click="cloth_slot('shoes')">Shoes</button>
            </div>
            <div class="swatches">
                <span class="swatch" data-for="c, i : cloth_swatches" data-style-background-color="c.css" data-event-click="cloth_colour(i)"><span class="tip">{{ c.name }}</span></span>
            </div>
            <p class="note">Every garment is cut from shapes the body itself carries, so it fits whatever the sliders do. Skirts are the engine's cloth: press Turn to see them swing. Click a worn garment again to take it off.</p>
        </div>
    </div>

    <div id="actions" class="bar">
        <button data-event-click="undo">Undo</button>
        <button data-event-click="redo">Redo</button>
        <button data-event-click="randomise('all')">Random person</button>
        <button data-event-click="save">Save</button>
        <button data-event-click="load">Load</button>
        <button data-event-click="copy_code">Copy code</button>
        <button data-event-click="paste_code">Paste code</button>
        <button class="primary" data-event-click="done">Done</button>
    </div>
    <div id="status" data-if="status != ''">{{ status }}</div>
    <div id="code">Share code: {{ code }}</div>
</body>
</rml>
