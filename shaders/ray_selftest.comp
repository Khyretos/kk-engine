#version 460
#extension GL_EXT_ray_query : require
// kke::rayQuerySelfTest (engine/src/RayScene.cpp): one ray per invocation
// through a kke::RayScene, the nearest hit written back for the CPU to check.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(std430, set = 0, binding = 1) readonly buffer Rays { vec4 rays[]; };  // per ray: origin + tMax, direction
layout(std430, set = 0, binding = 2) writeonly buffer Hits { vec4 hits[]; }; // t (-1 = miss), custom index, 0, 0

layout(push_constant) uniform Push { uint count; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    vec4 o = rays[i * 2u], d = rays[i * 2u + 1u];
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 0xFF, o.xyz, 0.0, d.xyz, o.w);
    while (rayQueryProceedEXT(q)) {
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
        hits[i] = vec4(rayQueryGetIntersectionTEXT(q, true), float(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)), 0.0, 0.0);
    else
        hits[i] = vec4(-1.0, 0.0, 0.0, 0.0);
}
