#version 450

// GPU-resident particle simulation: every invocation owns exactly one
// particle, reads/writes it in place, and decides for itself whether it's
// dead and needs respawning. No CPU readback, no CPU-side particle array —
// the whole simulation lives and dies on the GPU every frame.

struct Particle {
    vec4 position; // xyz = world position, w = remaining life (seconds)
    vec4 velocity; // xyz = velocity,       w = max life (seconds, for the fragment shader's color ramp)
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform ComputePushConstants {
    float dt;
    float time;
    uint particleCount;
    float padding;
} pc;

// Cheap integer hash (Thomas Wang's), used as a from-scratch PRNG seed —
// no textures, no precomputed noise buffer, just arithmetic.
float hash(uint x) {
    x = (x ^ 61u) ^ (x >> 16u);
    x *= 9u;
    x ^= (x >> 4u);
    x *= 0x27d4eb2du;
    x ^= (x >> 15u);
    return float(x) / 4294967295.0;
}

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.particleCount) return;

    Particle p = particles[i];
    p.position.w -= pc.dt;

    if (p.position.w <= 0.0) {
        // Respawn at the emitter with a randomized upward-cone velocity —
        // seed mixes the particle index with time so respawns don't repeat
        // in lockstep.
        uint seed = i * 7919u + floatBitsToUint(pc.time * 1000.0);
        float angle = hash(seed) * 6.2831853;
        float outSpeed = 1.0 + hash(seed + 1u) * 2.0;
        float upSpeed = 3.0 + hash(seed + 2u) * 2.5;
        float maxLife = 1.2 + hash(seed + 3u) * 1.6;

        p.position.xyz = vec3(0.0, 0.05, 0.0);
        p.velocity.xyz = vec3(cos(angle) * outSpeed * 0.4, upSpeed, sin(angle) * outSpeed * 0.4);
        p.position.w = maxLife;
        p.velocity.w = maxLife;
    } else {
        p.velocity.y -= 4.0 * pc.dt; // gravity
        p.position.xyz += p.velocity.xyz * pc.dt;
    }

    particles[i] = p;
}
