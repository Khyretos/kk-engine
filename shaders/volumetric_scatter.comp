#version 450
#extension GL_GOOGLE_include_directive : require
// Volumetric fog, step 1 of 2 (ENG-F03, kke::VolumetricFogPass): for each
// cell of the grid over the view frustum, how thick the height fog is there
// and the light it sends towards the camera: the sky's (the fog colour),
// the sun's where the shadow map says it reaches (light shafts), and the
// point lights' (halos). Lit fully, it matches fogInscatter() exactly, so
// turning the volume on changes only where light is blocked or added.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define KKE_COMPUTE
#include "pbr_common.glsl" // the lighting UBO (set 0) and the shadow map (set 1)

layout(set = 2, binding = 0, rgba16f) uniform writeonly image3D cells; // rgb = light towards the camera per unit of fog, a = extinction per metre

layout(push_constant) uniform Push {
    mat4 invViewProj; // the camera's, Vulkan's flipped Y
    vec4 grid;        // x = near distance, y = far distance, z = slices
} pc;

const float kShadowedSky = 0.35; // the fog colour's share left in the sun's shadow (the rest is sunlight)

// One hardware-filtered tap of the sun's shadow (computeShadow takes nine for surfaces): a cell is
// metres across, so the PCF's soft edge would not show, and this runs for every cell.
float sunShadow(vec3 p) {
    vec4 ls = lighting.lightViewProj * vec4(p, 1.0);
    vec3 proj = ls.xyz / ls.w;
    int c = shadowCascade(proj.xy);
    if (c < 0) return 1.0;
    vec4 so = lighting.cascadeScaleOffset[c];
    vec2 uv = lighting.shadowTiles[c].xy + ((proj.xy * so.xy + so.zw) * 0.5 + 0.5) * lighting.shadowTiles[c].zw;
    return texture(shadowMap, vec3(uv, proj.z - 0.0005 / so.x));
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(cells);
    if (any(greaterThanEqual(id, size))) return;
    vec2 ndc = (vec2(id.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec4 far = pc.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 ro = lighting.cameraPos.xyz;
    vec3 rd = normalize(far.xyz / far.w - ro);
    float dist = pc.grid.x * pow(pc.grid.y / pc.grid.x, (float(id.z) + 0.5) / pc.grid.z);
    vec3 p = ro + rd * dist;

    // The height fog's thickness here (as fogDepth integrates it).
    float b = max(lighting.fogParams.x, 1e-4);
    float sigma = lighting.fogColor.a * exp(-max(p.y - lighting.fogParams.y, -40.0 / b) * b);

    vec3 base = lighting.fogColor.rgb;
    float sun = lighting.ambient.a > 0.5 ? sunShadow(p) : 1.0;
    float glow = pow(max(dot(rd, sunDirection()), 0.0), 8.0) * lighting.fogParams.w;
    vec3 light = base * mix(kShadowedSky, 1.0, sun)
               + lighting.lights[0].colorIntensity.rgb * glow * dot(base, vec3(0.2126, 0.7152, 0.0722)) * sun;
    // Point lights: an even scatter of what reaches here.
    for (int i = 1; i < MAX_LIGHTS; ++i) {
        float intensity = lighting.lights[i].colorIntensity.a;
        if (intensity <= 0.0 || lighting.lights[i].directionOrPosition.w < 0.5) continue;
        light += lighting.lights[i].colorIntensity.rgb * intensity * lightFalloff(i, p) / (4.0 * PI);
    }
    imageStore(cells, id, vec4(light, sigma));
}
