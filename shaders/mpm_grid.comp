#version 450
#extension GL_GOOGLE_include_directive : require
// kke::MpmWater on the GPU, pass 2 of 4: grid velocities (MpmWater::substep
// step 5). One thread a node: momentum / mass, gravity, bodies and walls.
// What a body stops it receives, added up with integer atomics.
layout(local_size_x = 64) in;
#include "mpm_common.glsl"

void main() {
    uint n = flatIndex();
    uint nodes = uint(pc.dims.x * pc.dims.y * pc.dims.z);
    if (n >= nodes) return;
    int i = int(n) * 4;
    int m = grid[i + 3];
    if (m <= 0) {
        grid[i + 0] = 0; // float bits of 0.0
        grid[i + 1] = 0;
        grid[i + 2] = 0;
        return;
    }
    float mass = float(m) / kGridScale;
    vec3 v = vec3(float(grid[i + 0]), float(grid[i + 1]), float(grid[i + 2])) / kGridScale / mass + pc.gravity.xyz * pc.wallHi.w;
    int x = int(n) % pc.dims.x, y = (int(n) / pc.dims.x) % pc.dims.y, z = int(n) / (pc.dims.x * pc.dims.y);
    vec3 pos = pc.origin.xyz + vec3(x, y, z) * pc.origin.w;
    int count = int(pc.misc2.y);
    for (int b = 0; b < count; ++b) {
        vec3 nrm;
        if (bodyDistance(b, pos, nrm) >= kBodyBand * pc.origin.w) continue;
        vec3 center = bodies[b * 8 + 0].xyz;
        vec3 r = pos - center;
        vec3 vb = bodies[b * 8 + 3].xyz + cross(bodies[b * 8 + 4].xyz, r);
        vec3 vr = v - vb;
        float vn = dot(vr, nrm);
        if (vn >= 0.0) continue;
        vec3 vt = vr - vn * nrm;
        float lt = length(vt);
        float friction = bodies[b * 8 + 3].w;
        if (friction > 0.0 && lt > 0.0) vt *= max(0.0, 1.0 + friction * vn / lt);
        vec3 vnew = vb + vt;
        if (bodies[b * 8 + 2].w > 0.0) {
            vec3 J = (mass * pc.misc2.x) * (v - vnew);
            vec3 L = cross(r, J);
            atomicAdd(impulses[b * 8 + 0], toFixed(J.x, kImpulseScale));
            atomicAdd(impulses[b * 8 + 1], toFixed(J.y, kImpulseScale));
            atomicAdd(impulses[b * 8 + 2], toFixed(J.z, kImpulseScale));
            atomicAdd(impulses[b * 8 + 4], toFixed(L.x, kImpulseScale));
            atomicAdd(impulses[b * 8 + 5], toFixed(L.y, kImpulseScale));
            atomicAdd(impulses[b * 8 + 6], toFixed(L.z, kImpulseScale));
        }
        v = vnew;
    }
    bvec3 hit = bvec3(false);
    for (int a = 0; a < 3; ++a) {
        if ((pos[a] < pc.wallLo[a] + 0.5 * pc.origin.w && v[a] < 0.0) || (pos[a] > pc.wallHi[a] - 0.5 * pc.origin.w && v[a] > 0.0)) {
            v[a] = 0.0;
            hit[a] = true;
        }
    }
    if (pc.misc.z < 1.0 && any(hit))
        for (int a = 0; a < 3; ++a)
            if (!hit[a]) v[a] *= pc.misc.z;
    grid[i + 0] = floatBitsToInt(v.x);
    grid[i + 1] = floatBitsToInt(v.y);
    grid[i + 2] = floatBitsToInt(v.z);
}
